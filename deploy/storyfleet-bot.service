# STORYFLEET bot — requires UNIX user/group below to exist or systemd returns 217/USER.
# Verify before enable: id storyfleet
# See docs/OPERATIONS_STABILIZATION.md

[Unit]
Description=STORYFLEET Telegram Bot
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=storyfleet
Group=storyfleet
WorkingDirectory=/opt/autostory
Environment=PATH=/opt/autostory/venv/bin:/usr/bin
ExecStart=/opt/autostory/venv/bin/python main.py bot
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/storyfleet/bot.log
StandardError=append:/var/log/storyfleet/bot-error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/autostory/data /var/log/storyfleet

[Install]
WantedBy=multi-user.target
