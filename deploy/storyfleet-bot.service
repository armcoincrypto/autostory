[Unit]
Description=STORYFLEET Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autostory
Environment=PATH=/opt/autostory/venv/bin:/usr/bin
EnvironmentFile=-/opt/autostory/.env
ExecStart=/opt/autostory/venv/bin/python main.py bot
Restart=always
RestartSec=10

# Logging (ensure dir exists: sudo mkdir -p /var/log/storyfleet)
StandardOutput=append:/var/log/storyfleet/bot.log
StandardError=append:/var/log/storyfleet/bot-error.log

[Install]
WantedBy=multi-user.target
