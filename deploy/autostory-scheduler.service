[Unit]
Description=STORYFLEET scheduler worker
After=network.target autostory-web.service

[Service]
Type=simple
WorkingDirectory=/opt/autostory
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/autostory/.env
ExecStart=/opt/autostory/venv/bin/python main.py scheduler
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
