[Unit]
Description=STORYFLEET web dashboard (gunicorn)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/autostory
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/autostory/.env
ExecStart=/opt/autostory/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 600 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
