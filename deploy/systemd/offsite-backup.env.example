# Storyfleet off-host DR backup (Wave C)
# Install to: /etc/autostory/offsite-backup.env  (mode 0600)
# Generate encryption key: openssl rand -base64 48
#
# OFFSITE_BACKUP_ENABLED=true
# OFFSITE_BACKUP_REMOTE_USER=...
# OFFSITE_BACKUP_REMOTE_HOST=...
# OFFSITE_BACKUP_REMOTE_PATH=/home/.../storyfleet
# OFFSITE_BACKUP_SSH_KEY=/root/.ssh/...
# OFFSITE_BACKUP_RETENTION_DAYS=30
# OFFSITE_BACKUP_ENCRYPTION_KEY=...
