# STORYFLEET Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# TELEGRAM API CREDENTIALS
# Get these from https://my.telegram.org
# ============================================
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Database StringSession encryption (Phase 0.5; do not enable without migration runbook)
# disabled | transition | encrypted-only
TELEGRAM_SESSION_ENCRYPTION_MODE=disabled
# Required for transition/encrypted-only. Key must decode to exactly 32 random bytes.
TELEGRAM_SESSION_ENCRYPTION_ACTIVE_KEY_ID=
TELEGRAM_SESSION_ENCRYPTION_KEY_B64=
# Rotation alternative: JSON object mapping key IDs to base64url keys.
# TELEGRAM_SESSION_ENCRYPTION_KEYS_JSON={}

# ============================================
# RATE LIMITING (Anti-detection)
# ============================================
TELEGRAM_MIN_DELAY_BETWEEN_ACTIONS=2.0
TELEGRAM_MAX_DELAY_BETWEEN_ACTIONS=5.0
TELEGRAM_MAX_STORIES_PER_HOUR=10
TELEGRAM_MAX_MENTIONS_PER_STORY=5

# ============================================
# DATABASE CONFIGURATION
# ============================================
# SQLite (default for development)
DATABASE_URL=sqlite:///./data/storyfleet.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/storyfleet

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password

# ============================================
# DASHBOARD CONFIGURATION
# ============================================
DASHBOARD_SECRET_KEY=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false
# Required in production: shared secret for admin API (X-Admin-Token header)
DASHBOARD_ADMIN_TOKEN=

# ============================================
# TELEGRAM BOT DASHBOARD (Optional)
# ============================================
BOT_TOKEN=
BOT_ADMIN_IDS=[123456789, 987654321]
OPENAI_API_KEY=

# Owner Messages — Claude draft assistant (draft only; never sends Telegram)
CLAUDE_DRAFT_ENABLED=false
ANTHROPIC_API_KEY=
CLAUDE_DRAFT_MODEL=claude-sonnet-4-20250514
CLAUDE_DRAFT_TIMEOUT_SEC=20
CLAUDE_DRAFT_MAX_OUTPUT_TOKENS=512
CLAUDE_DRAFT_MAX_CONTEXT_MESSAGES=20
CLAUDE_DRAFT_MAX_INPUT_CHARS=12000

# ============================================
# STORAGE PATHS
# ============================================
STORAGE_SESSIONS_DIR=./data/sessions
STORAGE_MEDIA_DIR=./data/media
STORAGE_LOGS_DIR=./data/logs

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=STORYFLEET
# production | development | test. REQUIRED: set ENVIRONMENT=production on live servers.
# Local/Mac MUST remain development or test. Non-production cannot publish Stories
# even if the flags below are accidentally set true.
ENVIRONMENT=development
# Scheduler and execution gates remain fail-closed by default.
SCHEDULER_MUTATIONS_ENABLED=false
STORY_EXECUTION_ENABLED=false
CAMPAIGN_EXECUTION_ENABLED=false
CONTROLLED_STORY_EXECUTION_ENABLED=false
SCHEDULER_STORY_EXECUTION_ENABLED=false
STORY_MUTATIONS_ENABLED=false
STORY_EXECUTION_MODE=disabled
AUTOSTORY_MENTIONS_PRODUCTION_CERTIFIED=false
META_FACEBOOK_PUBLISHING_ENABLED=false
META_INSTAGRAM_PUBLISHING_ENABLED=false
META_PUBLISHING_EXECUTION_MODE=disabled
DISCOVERY_EXECUTION_ENABLED=false
EXECUTION_EMERGENCY_LOCK=false
AI_CODING_EXECUTE_ENABLED=false
# DASHBOARD_INJECT_ADMIN_TOKEN=false
# DASHBOARD_ALLOW_QUERY_ADMIN_TOKEN=false
# For production: ENVIRONMENT=production
LOG_LEVEL=INFO

# ============================================
# SCHEDULER DEFAULTS (auto-provision + new profiles)
# ============================================
# SCHED_DEFAULT_TIMEZONE=Asia/Yerevan
# SCHED_DEFAULT_MIN_INTERVAL_SEC=600
# SCHED_DEFAULT_DAILY_TOTAL=20
# SCHED_DEFAULT_DAILY_PROMO=10
# SCHED_DEFAULT_DAILY_INFO=10
# SCHED_DEFAULT_JITTER_SEC=300
# SCHED_DEFAULT_QUIET_HOURS_JSON={}
# SCHED_DEFAULT_RULE_PROMO_TIMES_JSON=["RANDOM:10:00-21:00"]
# SCHED_DEFAULT_RULE_INFO_TIMES_JSON=["RANDOM:12:00-20:00"]

# ============================================
# AI AGENT — dedicated Telegram accounts (optional)
# ============================================
# These accounts remain excluded from campaign selectors.
# AI_AGENT_ACCOUNT_IDS=110,113,131
# AI_AGENT_ACCOUNT_PHONES=+10000000001,+10000000002,+10000000003

# AI background execution stays disabled unless separately approved.
AI_AGENT_AUTO_LOOP_ENABLED=false

# ============================================
# SOCIAL AGENT — Meta OAuth (never expose secret to browser)
# ============================================
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=https://ex.zellotex.com/social-agent/accounts/meta/callback
# META_APP_MODE=development
# META_FACEBOOK_PUBLISHING_ENABLED=false
# META_INSTAGRAM_PUBLISHING_ENABLED=false
# Dedicated Social Agent credential encryption (32-byte keys, base64url), separate from Telegram keys:
# SOCIAL_CREDENTIAL_ACTIVE_KEY_ID=sa-cred-1
# SOCIAL_CREDENTIAL_KEYS_JSON={"sa-cred-1":"<base64url-32-bytes>"}
# SOCIAL_AGENT_AI_PROVIDER=
# SOCIAL_AGENT_DEBUG_ENABLED=false
